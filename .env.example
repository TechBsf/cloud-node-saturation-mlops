# AWS / SageMaker
AWS_REGION=eu-west-3
S3_BUCKET=your-s3-bucket
SAGEMAKER_ROLE_ARN=arn:aws:iam::000000000000:role/your-role

# MLflow (optionnel)
MLFLOW_TRACKING_URI=

# API
MODEL_PATH=model/model.joblib

# Interrupteur de déploiement (workflow CD)
DEPLOY_ENABLED=false
DEPLOY_ROLE_ARN=arn:aws:iam::000000000000:role/github-deploy-role
